<Window x:Class="AnnotImg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnnotImg"
        Title="AnnotImg" Width="1280" Height="820" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" Loaded="Window_Loaded"
        FontFamily="Yu Gothic UI" FontSize="13" Background="#F3F3F3">
    <Window.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
        <Style x:Key="ColorButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="ToolTip" Value="クリックして色を選択" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="GroupName" Value="Tools" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" x:Key="TbButton">
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="#F3F3F3">
            <ToolBar Background="#F3F3F3" Loaded="ToolBar_Loaded">
                <Button Style="{StaticResource TbButton}" Content="開く" Click="Open_Click" ToolTip="画像を開く (Ctrl+O)" />
                <Button Style="{StaticResource TbButton}" Content="保存" Click="Save_Click" x:Name="SaveButton" ToolTip="名前を付けて保存 (Ctrl+S)" />
                <Separator />
                <Button Style="{StaticResource TbButton}" Content="元に戻す" Click="Undo_Click" x:Name="UndoButton" ToolTip="元に戻す (Ctrl+Z)" />
                <Button Style="{StaticResource TbButton}" Content="やり直し" Click="Redo_Click" x:Name="RedoButton" ToolTip="やり直し (Ctrl+Y)" />
                <Separator />
                <RadioButton x:Name="ToolSelect" Content="選択" Tag="{x:Static local:ToolKind.Select}" Checked="Tool_Checked" IsChecked="True" ToolTip="選択・移動・変形 (V)" />
                <RadioButton x:Name="ToolText" Content="文字" Tag="{x:Static local:ToolKind.Text}" Checked="Tool_Checked" ToolTip="文字列 (T)" />
                <RadioButton x:Name="ToolArrow" Content="矢印" Tag="{x:Static local:ToolKind.Arrow}" Checked="Tool_Checked" ToolTip="矢印 (A)" />
                <RadioButton x:Name="ToolLine" Content="線" Tag="{x:Static local:ToolKind.Line}" Checked="Tool_Checked" ToolTip="線 (L)" />
                <RadioButton x:Name="ToolEllipse" Content="円" Tag="{x:Static local:ToolKind.Ellipse}" Checked="Tool_Checked" ToolTip="円 (E)" />
                <RadioButton x:Name="ToolRect" Content="四角形" Tag="{x:Static local:ToolKind.Rectangle}" Checked="Tool_Checked" ToolTip="四角形 (R)" />
                <RadioButton x:Name="ToolBlur" Content="ぼかし" Tag="{x:Static local:ToolKind.Blur}" Checked="Tool_Checked" ToolTip="範囲をぼかす (B)" />
                <Separator />
                <Button Style="{StaticResource TbButton}" Content="削除" Click="Delete_Click" x:Name="DeleteButton" ToolTip="選択中のオブジェクトを削除 (Delete)" />
                <Separator />
                <Button Style="{StaticResource TbButton}" Content="－" Click="ZoomOut_Click" ToolTip="縮小 (Ctrl+-)" />
                <Button Style="{StaticResource TbButton}" Content="＋" Click="ZoomIn_Click" ToolTip="拡大 (Ctrl++)" />
                <Button Style="{StaticResource TbButton}" Content="全体" Click="ZoomFit_Click" ToolTip="ウィンドウに合わせる (Ctrl+0)" />
                <Button Style="{StaticResource TbButton}" Content="100%" Click="Zoom100_Click" ToolTip="等倍 (Ctrl+1)" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="#E8E8E8">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="画像を開くか、ウィンドウにドロップしてください" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" />
            </StatusBarItem>
        </StatusBar>

        <!-- プロパティパネル -->
        <Border DockPanel.Dock="Right" Width="250" BorderBrush="#DDD" BorderThickness="1,0,0,0" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PropsPanel" Margin="14,4,14,14">
                    <TextBlock x:Name="PropsHeader" Text="スタイル" FontSize="15" FontWeight="Bold" Margin="0,8,0,0" />

                    <StackPanel x:Name="GroupColor">
                        <TextBlock x:Name="ColorLabel" Text="線・文字の色" Style="{StaticResource GroupTitle}" />
                        <Button x:Name="StrokeColorButton" Style="{StaticResource ColorButton}" Click="StrokeColor_Click">
                            <Border x:Name="StrokeSwatch" Width="46" Height="16" BorderBrush="#888" BorderThickness="1" />
                        </Button>
                        <WrapPanel x:Name="StrokePalette" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="GroupThickness">
                        <TextBlock Style="{StaticResource GroupTitle}">
                            <Run Text="線の太さ: " /><Run x:Name="ThicknessText" Text="4" /><Run Text=" px" />
                        </TextBlock>
                        <Slider x:Name="ThicknessSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="2" ValueChanged="Thickness_Changed" />
                    </StackPanel>

                    <StackPanel x:Name="GroupLineStyle">
                        <TextBlock Text="線種" Style="{StaticResource GroupTitle}" />
                        <ComboBox x:Name="LineStyleCombo" SelectionChanged="LineStyle_Changed">
                            <ComboBoxItem Content="直線" Tag="{x:Static local:LineStyle.Solid}" />
                            <ComboBoxItem Content="点線" Tag="{x:Static local:LineStyle.Dot}" />
                            <ComboBoxItem Content="破線" Tag="{x:Static local:LineStyle.Dash}" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="GroupFill">
                        <TextBlock Text="塗りの色" Style="{StaticResource GroupTitle}" />
                        <Button x:Name="FillColorButton" Style="{StaticResource ColorButton}" Click="FillColor_Click">
                            <Border x:Name="FillSwatch" Width="46" Height="16" BorderBrush="#888" BorderThickness="1" />
                        </Button>
                        <WrapPanel x:Name="FillPalette" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource GroupTitle}">
                            <Run Text="塗りの不透明度: " /><Run x:Name="FillOpacityText" Text="0" /><Run Text=" %" />
                        </TextBlock>
                        <Slider x:Name="FillOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                SmallChange="5" LargeChange="10" ValueChanged="FillOpacity_Changed" />
                        <TextBlock Text="0% で塗りなし" Foreground="#888" FontSize="11" />
                    </StackPanel>

                    <StackPanel x:Name="GroupRounded">
                        <CheckBox x:Name="RoundedCheck" Content="角を丸くする" Margin="0,12,0,0"
                                  Checked="Rounded_Changed" Unchecked="Rounded_Changed" />
                    </StackPanel>

                    <StackPanel x:Name="GroupFont">
                        <TextBlock Text="フォント" Style="{StaticResource GroupTitle}" />
                        <ComboBox x:Name="FontCombo" SelectionChanged="Font_Changed" DisplayMemberPath="DisplayName" MaxDropDownHeight="400">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <TextBlock Style="{StaticResource GroupTitle}">
                            <Run Text="文字サイズ: " /><Run x:Name="FontSizeText" Text="32" /><Run Text=" px" />
                        </TextBlock>
                        <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="4" ValueChanged="FontSize_Changed" />
                    </StackPanel>

                    <StackPanel x:Name="GroupBlur">
                        <TextBlock Text="ぼかし" Style="{StaticResource GroupTitle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="ドラッグした範囲をぼかします。ぼかしは元画像に対してかかり、他のオブジェクトはぼかされません。" />
                    </StackPanel>

                    <TextBlock Text="操作" Style="{StaticResource GroupTitle}" Margin="0,24,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12" LineHeight="19">
                        ・ドラッグで作成、作成後は選択ツールに戻ります<LineBreak />
                        ・Shift: 45°単位 / 正方形・正円<LineBreak />
                        ・文字はダブルクリックで再編集<LineBreak />
                        ・文字の確定: Esc / Ctrl+Enter / 外をクリック<LineBreak />
                        ・矢印キーで1px移動 (Shift で10px)<LineBreak />
                        ・Ctrl+ホイールで拡大縮小
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Background="#3A3A3A">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel" Focusable="False">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <local:EditorCanvas x:Name="Editor" />
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBB" FontSize="18" TextAlignment="Center" IsHitTestVisible="False">
                画像ファイル (PNG / JPEG) をここにドロップ<LineBreak />または「開く」(Ctrl+O) から選択
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
