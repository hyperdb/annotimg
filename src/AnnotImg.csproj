<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AnnotImg</AssemblyName>
    <RootNamespace>AnnotImg</RootNamespace>
    <!-- exe に埋め込むアイコン（ウィンドウのタイトルバー・タスクバーにもこのアイコンが使われる） -->
    <ApplicationIcon>..\annotimg.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 配布用: .NET ランタイムを同梱しない単一 exe として発行する（実行には .NET デスクトップ ランタイムが必要） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SkiaSharp のネイティブ DLL (libSkiaSharp.dll) も exe に含め、起動時に一時フォルダーへ展開する -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- SkiaSharp のネイティブ用デバッグシンボル（約95MB）は配布に不要なので除外 -->
  <Target Name="RemoveNativePdbFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
  </Target>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
  </ItemGroup>

</Project>
